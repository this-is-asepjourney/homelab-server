# ──────────────────────────────────────────────────────
# IoT Dashboard — Environment Configuration
# ──────────────────────────────────────────────────────

# ── Grafana ────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=adminpassword
# URL Grafana eksisting di server homelab (Port 3001 sesuai port.md: 192.168.25.101:3001)
EXISTING_GRAFANA_URL=http://192.168.25.101:3001
GRAFANA_TAILSCALE_URL=http://100.106.63.90:3001

# ── MQTT Broker ────────────────────────────────────────
# Menggunakan Mosquitto MQTT broker yang sudah ada di server homelab (Port 1883)
MQTT_BROKER_HOST=192.168.25.101
MQTT_TAILSCALE_HOST=100.106.63.90
MQTT_BROKER_PORT=1883
MQTT_USERNAME=useriot
MQTT_PASSWORD=25022002

# ── API Behavior & Personal API Platform (Main API) ────────────────
# Berapa menit terakhir untuk menganggap device sebagai "Online"
ONLINE_THRESHOLD_MINUTES=5
IOT_API_PORT=8002
IOT_WEB_PORT=8088
IOT_PROMETHEUS_PORT=9095
IOT_GRAFANA_PORT=3003
IOT_TELEGRAF_PORT=9273

# Koneksi ke Prometheus yang sudah berjalan di server homelab (Port 9001)
PROMETHEUS_URL=http://192.168.25.101:9001

# Koneksi ke Personal API Platform sebagai API Utama (Port 8000)
PAP_API_URL=http://192.168.25.101:8000
PAP_API_KEY=pap_key_iot_dashboard_default_secret_key_2026
