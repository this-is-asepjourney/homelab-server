      "title": "📈 Grafik Riwayat Suhu (°C), Kelembapan (%) & Heat Index (Pipeline: InfluxDB + MySQL + MQTT)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iot"
          },
          "query": "from(bucket: \"eternal_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"iot_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature\" or r[\"_field\"] == \"humidity\" or r[\"_field\"] == \"heat_index\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "mysql",
            "uid": "mysql-iot-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT UNIX_TIMESTAMP(recorded_at) AS time, temperature_c AS 'Suhu (°C)', humidity_pct AS 'Kelembapan (%)', heat_index_c AS 'Heat Index (°C)' FROM iot_telemetry_logs WHERE $__timeFilter(recorded_at) OR recorded_at >= NOW() - INTERVAL 12 HOUR ORDER BY recorded_at ASC;",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sysctrl_suhu{MCID=\"ETL-ESP32-001\"} or sysctrl_suhu or eternal_iot_suhu",
          "legendFormat": "MQTT Suhu (°C)",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sysctrl_humidity{MCID=\"ETL-ESP32-001\"} or sysctrl_humidity or eternal_iot_humidity",
          "legendFormat": "MQTT Humidity (%)",
          "refId": "D"
        }
      ]
    },
