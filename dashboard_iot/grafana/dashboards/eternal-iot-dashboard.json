      "title": "⏳ Sisa Timer Auto-Lock (Maks 2 Jam)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "mysql-iot-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN is_locked = 0 AND unlock_expires_at > NOW() THEN TIMESTAMPDIFF(SECOND, NOW(), unlock_expires_at) ELSE 0 END AS remaining_sec FROM device_locks WHERE device_serial = 'ETL-ESP32-001' LIMIT 1;",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-iot"
          },
          "query": "from(bucket: \"eternal_telemetry\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"iot_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"remaining_sec\")\n  |> last()",
          "refId": "B"
