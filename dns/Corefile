# CoreDNS Configuration for Homelab Server (fa)
# Resolves *.homelab and *.fa.local to Homelab Server IPs:
#   LAN IP: 192.168.25.101
#   Tailscale IP: 100.106.63.90

homelab:53 {
    hosts /etc/coredns/homelab.hosts {
        192.168.25.101 psm.homelab api.homelab iot.homelab grafana.homelab prometheus.homelab kuma.homelab vault.homelab cockpit.homelab router.homelab
        100.106.63.90 psm.tailscale.homelab api.tailscale.homelab iot.tailscale.homelab grafana.tailscale.homelab
        fallthrough
    }
    template IN A {
        match (.*)\.homelab
        answer "{{ .Name }} 60 IN A 192.168.25.101"
        fallthrough
    }
    reload 5s
    log
    errors
    cache 30
}

fa.local:53 {
    hosts /etc/coredns/homelab.hosts {
        192.168.25.101 psm.fa.local api.fa.local iot.fa.local grafana.fa.local prometheus.fa.local kuma.fa.local
        fallthrough
    }
    template IN A {
        match (.*)\.fa\.local
        answer "{{ .Name }} 60 IN A 192.168.25.101"
        fallthrough
    }
    reload 5s
    log
    errors
    cache 30
}

.:53 {
    forward . 1.1.1.1 8.8.8.8 1.0.0.1
    cache 30
    log
    errors
}
