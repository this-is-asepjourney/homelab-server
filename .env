# =============================================================================
# HOMELAB SERVER — MODULAR MULTI-PROJECT CONFIGURATION
# Decoupled into: [WEB] [IOT] [APP & CORE PLATFORM] [BUSINESS / UMKM]
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. NETWORK & SYSTEM HOSTS
# ─────────────────────────────────────────────────────────────────────────────
HOST_IP=192.168.25.101
TAILSCALE_HOST=100.106.63.90
LOCAL_HOST=192.168.25.101
ENVIRONMENT=development
DEBUG=true

# ─────────────────────────────────────────────────────────────────────────────
# 2. [WEB LAYER] — FRONTEND WEB DASHBOARDS & REVERSE PROXY
# ─────────────────────────────────────────────────────────────────────────────
# Mission Control & Personal Server Manager Web UI
PSM_WEB_PORT=3005

# IoT Fleet & Armada Heatpress Web Dashboard
IOT_WEB_PORT=8088

# Grafana Realtime Homelab Monitoring (Eksisting Port 3001)
EXISTING_GRAFANA_URL=http://192.168.25.101:3001
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=adminpassword

# CoreDNS & Nginx Ingress Gateway
DNS_PORT=53
INGRESS_HTTP_PORT=80
INGRESS_HTTPS_PORT=443

# ─────────────────────────────────────────────────────────────────────────────
# 3. [IOT LAYER] — HARDWARE TELEMETRY, BROKERS & TSDB
# ─────────────────────────────────────────────────────────────────────────────
# Mosquitto MQTT Broker (Eksisting Port 1883)
MQTT_HOST=192.168.25.101
MQTT_BROKER_HOST=192.168.25.101
MQTT_PORT=1883
MQTT_BROKER_PORT=1883
MQTT_USERNAME=useriot
MQTT_PASSWORD=25022002

# InfluxDB v2 (Dedicated Time-Series IoT Telemetry DB :8086)
INFLUXDB_HOST=192.168.25.101
INFLUXDB_PORT=8086
INFLUXDB_URL=http://192.168.25.101:8086
INFLUXDB_USER=appuser
INFLUXDB_PASSWORD=admin12345
INFLUXDB_ORG=homelab
INFLUXDB_BUCKET=eternal_telemetry
INFLUXDB_TOKEN=homelab-influxdb-master-auth-token-2026

# IoT Telemetry Scraper & Prometheus Exporter
IOT_TELEGRAF_PORT=9273
PROMETHEUS_URL=http://host.docker.internal:9001
PROMETHEUS_PORT=9001

# IoT Hardware Storage (MySQL :3306)
IOT_DB_NAME=eternal_db
ETERNAL_DB_NAME=eternal_db

# ─────────────────────────────────────────────────────────────────────────────
# 4. [APP LAYER] — PAP CORE API GATEWAY & DECOUPLED WORKER
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Personal API Platform
APP_ENV=development
API_PREFIX=/api/v1

# Central Unified Core Gateway (:8000)
PAP_PORT=8000
PAP_API_URL=http://192.168.25.101:8000
PAP_CORE_API_URL=http://192.168.25.101:8000/api

# Service Keys & Inter-Platform Auth
PAP_API_KEY=pap_key_central_api_default_secret_2026
PAP_PSM_SERVICE_KEY=pap_key_psm_control_plane_default_secret_key_2026
PAP_IOT_SERVICE_KEY=pap_key_iot_dashboard_default_secret_key_2026
HOMELAB_AGENT_TOKEN=psm_agent_homelab_default_token

# Platform Core Database (PostgreSQL :5432)
POSTGRES_HOST=192.168.25.101
POSTGRES_PORT=5432
POSTGRES_DB=psm
POSTGRES_USER=appuser
POSTGRES_PASSWORD=admin12345
DATABASE_URL=postgresql+psycopg2://appuser:admin12345@192.168.25.101:5432/psm
PAP_DATABASE_URL=postgresql+psycopg://appuser:admin12345@192.168.25.101:5432/pap_core

# MySQL Server Master Identity (:3306)
MYSQL_HOST=192.168.25.101
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=adminroot12345
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=admin12345
MYSQL_MAJOR=8.4

# ─────────────────────────────────────────────────────────────────────────────
# 5. [BUSINESS / UMKM LAYER] — POS CASHIER & STOCK MANAGEMENT
# ─────────────────────────────────────────────────────────────────────────────
UMKM_DB_NAME=stock_umkm
STOCK_DB_HOST=192.168.25.101
STOCK_DB_PORT=3306
STOCK_DB_NAME=stock_umkm
STOCK_DB_USER=appuser
STOCK_DB_PASSWORD=admin12345
STOCK_UMKM_API_URL=http://192.168.25.101:8000/api
STOCK_UMKM_API_KEY=pap_key_stock_umkm_default_secret_key_2026
POS_CASHIER_WEBHOOK_URL=http://192.168.25.101:3000/api/webhooks/pap

# ─────────────────────────────────────────────────────────────────────────────
# 6. SECURITY & ENCRYPTION MASTER KEYS
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=b8f36a89270df8417727e025170d1fa78f5f4d8520857ef51fa930f785b96a4e
ENCRYPTION_MASTER_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTMyeS0=
JWT_SECRET=b8f36a89270df8417727e025170d1fa78f5f4d8520857ef51fa930f785b96a4e
JWT_ISSUER=personal-api-platform
JWT_AUDIENCE=pap-clients
