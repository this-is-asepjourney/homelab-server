# =============================================================================
# HOMELAB SERVER — UNIFIED ENVIRONMENT CONFIGURATION
# Meliputi: Personal API Platform, Personal Server Manager, dan IoT Dashboard
# Sesuai dengan audit port server di port.md
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. NETWORK & HOST CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
HOST_IP=192.168.25.101
TAILSCALE_HOST=100.106.63.90
LOCAL_HOST=192.168.25.101
ENVIRONMENT=development
DEBUG=true

# ─────────────────────────────────────────────────────────────────────────────
# 2. STANDAR PORT ALOKASI (ANTI-BENTROK DENGAN LAYANAN EKSISTING)
# ─────────────────────────────────────────────────────────────────────────────
# PAP (Personal API Platform)
PAP_PORT=8000

# PSM (Personal Server Manager)
PSM_API_PORT=8001
PSM_WEB_PORT=3005

# IoT Dashboard & Fleet Management
IOT_API_PORT=8002
IOT_WEB_PORT=8088
IOT_TELEGRAF_PORT=9273

# ─────────────────────────────────────────────────────────────────────────────
# 3. KONEKSI KE LAYANAN EKSISTING HOMELAB (TANPA KONTAINER DUPLIKAT)
# ─────────────────────────────────────────────────────────────────────────────
# Mosquitto MQTT Broker (Eksisting Port 1883)
MQTT_HOST=192.168.25.101
MQTT_BROKER_HOST=192.168.25.101
MQTT_TAILSCALE_HOST=100.106.63.90
MQTT_PORT=1883
MQTT_BROKER_PORT=1883
MQTT_USERNAME=useriot
MQTT_PASSWORD=25022002

# Prometheus Server Utama (Eksisting Snap di Port 9001)
PROMETHEUS_URL=http://host.docker.internal:9001
PROMETHEUS_PORT=9001

# Grafana Utama (Eksisting di Port 3001)
EXISTING_GRAFANA_URL=http://192.168.25.101:3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=adminpassword

# PostgreSQL (Eksisting di Port 5432)
POSTGRES_HOST=192.168.25.101
POSTGRES_PORT=5432
POSTGRES_DB=psm
POSTGRES_USER=appuser
POSTGRES_PASSWORD=admin12345
DATABASE_URL=postgresql+psycopg2://appuser:admin12345@192.168.25.101:5432/psm
PAP_DATABASE_URL=postgresql+psycopg://appuser:admin12345@192.168.25.101:5432/pap_core

# MySQL 8.4 (Eksisting di Port 3306)
MYSQL_HOST=192.168.25.101
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=adminroot12345
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=admin12345
MYSQL_MAJOR=8.4
MYSQL_VERSION=8.4.13-1.el9
MYSQL_SHELL_VERSION=8.4.10-1.el9

# MySQL Database Integration for PAP & Apps
STOCK_DB_HOST=192.168.25.101
STOCK_DB_PORT=3306
STOCK_DB_NAME=appdb
STOCK_DB_USER=appuser
STOCK_DB_PASSWORD=admin12345
STOCK_UMKM_API_URL=http://192.168.25.101:8080/api
STOCK_UMKM_API_KEY=pap_key_stock_umkm_default_secret_key_2026

# ─────────────────────────────────────────────────────────────────────────────
# 4. INTER-SERVICE INTEGRATION & TOKENS
# ─────────────────────────────────────────────────────────────────────────────
# Personal API Platform (Main Core API)
APP_NAME=Personal API Platform
APP_ENV=development
API_PREFIX=/api/v1
PAP_API_URL=http://192.168.25.101:8000

# Service Keys untuk komunikasi aman antar service
PAP_PSM_SERVICE_KEY=pap_key_psm_control_plane_default_secret_key_2026
PAP_IOT_SERVICE_KEY=pap_key_iot_dashboard_default_secret_key_2026
PAP_API_KEY=pap_key_psm_control_plane_default_secret_key_2026

# Personal Server Manager (PSM)
HOMELAB_AGENT_TOKEN=psm_agent_homelab_default_token
NEXT_PUBLIC_API_URL=http://192.168.25.101:8001
NEXT_PUBLIC_WS_URL=ws://192.168.25.101:8001
CONTROL_PLANE_URL=http://psm-api:8000
IOT_DASHBOARD_URL=http://192.168.25.101:8088

# IoT Threshold
ONLINE_THRESHOLD_MINUTES=5

# Security Secrets (Ganti pada production)
SECRET_KEY=b8f36a89270df8417727e025170d1fa78f5f4d8520857ef51fa930f785b96a4e
ENCRYPTION_MASTER_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTMyeS0=
JWT_SECRET=b8f36a89270df8417727e025170d1fa78f5f4d8520857ef51fa930f785b96a4e
JWT_ISSUER=personal-api-platform
