# ==========================================
# Personal Server Manager (PSM) Environment
# ==========================================

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
# Note: For instant local testing without Docker, SQLite fallback is supported: sqlite:///./psm.db
POSTGRES_DB=psm
POSTGRES_USER=appuser
POSTGRES_PASSWORD=admin12345
POSTGRES_HOST=100.106.63.90
POSTGRES_PORT=5432
# Docker Compose builds the API DATABASE_URL automatically from POSTGRES_* above.
# Only set PSM_DATABASE_URL if you want to point to an external database.
# PSM_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/psm

# Security & Tokens
# Generate via: openssl rand -hex 32
SECRET_KEY=b8f36a89270df8417727e025170d1fa78f5f4d8520857ef51fa930f785b96a4e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption key for sensitive project environment variables (Fernet key, 32 url-safe base64-encoded bytes)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTMyeS0=

# Ports for Homelab integration (PAP Main API uses port 8000)
WEB_PORT=3005
API_PORT=8001
PROMETHEUS_PORT=9001

# URLs
NEXT_PUBLIC_API_URL=http://192.168.25.101:8001
NEXT_PUBLIC_WS_URL=ws://192.168.25.101:8001
CONTROL_PLANE_URL=http://192.168.25.101:8001
CONTROL_PLANE_WS=ws://192.168.25.101:8001/api/v1/agents/connect

# Personal API Platform (Main API / API Utama) & IoT Dashboard Integration
PAP_API_URL=http://192.168.25.101:8000
PAP_API_KEY=pap_key_psm_control_plane_default_secret_key_2026
IOT_DASHBOARD_URL=http://192.168.25.101:8088

# Tailscale & Homelab Network Reference
TAILSCALE_HOST=100.106.63.90
LOCAL_HOST=192.168.25.101

# Homelab Mosquitto MQTT Broker
MQTT_HOST=192.168.25.101
MQTT_TAILSCALE_HOST=100.106.63.90
MQTT_PORT=1883
MQTT_USERNAME=useriot
MQTT_PASSWORD=25022002

# Storage paths
UPLOAD_STORAGE_PATH=/opt/psm/workspaces/uploads
RELEASE_STORAGE_PATH=/opt/psm/releases
